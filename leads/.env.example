# Copie este arquivo para ".env" e ajuste os valores.
# Em produção (Render, Railway etc.), cadastre estas variáveis no painel da hospedagem.

# Endereço do banco Postgres.
# No computador, se ficar vazio, o "npm run dev" sobe um Postgres local sozinho.
DATABASE_URL=

# Endereço público do sistema, sem barra no final (usado nos links de convite).
APP_URL=http://localhost:5173

# Porta do servidor (a hospedagem normalmente define sozinha).
PORT=3000

# Código para o "primeiro acesso" pela tela (criar o primeiro administrador).
# Deixe vazio para desligar essa tela e criar o administrador pelo comando "npm run criar-admin".
SETUP_TOKEN=

# Aplica as migrações do banco ao iniciar (recomendado: true).
MIGRATE_ON_START=true

# Nível de log: fatal, error, warn, info, debug.
LOG_LEVEL=info

# Coloque "true" se o sistema estiver atrás de um proxy/HTTPS da hospedagem (Render, Railway, Nginx).
TRUST_PROXY=false

# ---------- WhatsApp Business Cloud API (opcional, desligado) ----------
# Veja docs/WHATSAPP-CLOUD-API.md antes de ligar.
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
