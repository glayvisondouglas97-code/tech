# Copie este arquivo para ".env" e troque os valores.
# Use SÓ letras e números nas senhas e chaves (sem símbolos), para não quebrar as URLs de conexão.

# Banco de dados (Postgres)
POSTGRES_USER=central
POSTGRES_PASSWORD=troque_esta_senha

# Chave mestra da Evolution API. Só o backend usa, e ela nunca vai para o navegador.
EVOLUTION_API_KEY=troque_esta_chave

# Token secreto que a Evolution envia junto com cada webhook para o backend.
WEBHOOK_TOKEN=troque_este_token

# Porta do sistema no seu computador (http://localhost:3100). Troque só se ela já estiver em uso.
# APP_PORT=3100

# ---- Só no VPS (produção) ----
# Endereço do sistema. Crie antes no seu provedor de domínio um registro A apontando para o IP do VPS.
# DOMAIN=whats.suaempresa.com.br
# Faz o "docker compose" usar também o Caddy (HTTPS):
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
