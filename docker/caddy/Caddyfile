# HTTPS automático (Let's Encrypt) para o domínio definido em DOMAIN no .env.
{$DOMAIN} {
	encode zstd gzip

	# O webhook da Evolution usa só a rede interna do Docker: nunca fica aberto na internet.
	@webhook path /webhook/*
	respond @webhook 404

	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy app:3000
}
