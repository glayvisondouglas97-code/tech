{
  "name": "central-whatsapp-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "check": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "express": "5.2.1",
    "pg": "8.23.0",
    "prisma": "7.10.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  }
}
